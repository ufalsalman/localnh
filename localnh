#!/usr/bin/env bash
# localnh Headless CLI Management Tool
# Routes command-line arguments to the appropriate Python utility script using the project's venv.

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_EXEC="$SCRIPT_DIR/venv/bin/python"

# Fallback to system python if virtual environment is not present
if [ ! -f "$PYTHON_EXEC" ]; then
    PYTHON_EXEC="python"
fi

# Container CLI writers must share ownership with PHP, including files created
# after startup. Explicit storage initialization remains an operator/root task.
if [ "${LOCALNH_CONTAINER:-}" = "1" ] && [ "$(id -u)" = "0" ] && ! { [ "${1:-}" = "storage" ] && [ "${2:-}" = "init" ]; }; then
    exec runuser -u www-data -- "$SCRIPT_DIR/localnh" "$@"
fi

# Subcommand dispatching
if [ "$1" = "delete" ] || [ "$1" = "--delete" ] || [ "$1" = "-d" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/delete.py" "$@"
elif [ "$1" = "pdf" ] || [ "$1" = "--pdf" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/pdf.py" "$@"
elif [ "$1" = "html" ] || [ "$1" = "--html" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/html.py" "$@"
elif [ "$1" = "snapshot" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/snapshot.py" "$@"
elif [ "$1" = "storage" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/storage.py" "$@"
elif [ "$1" = "stats" ] || [ "$1" = "--stats" ] || [ "$1" = "-s" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/stats.py" "$@"
elif [ -z "$1" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    echo "localnh CLI Tool"
    echo "Usage:"
    printf "  %-44s %s\n" "./localnh <gallery_id>" "Fetch a gallery by ID"
    printf "  %-44s %s\n" "./localnh storage paths" "Show selected paths (no secrets)"
    printf "  %-44s %s\n" "./localnh storage init" "Explicitly initialize empty external storage"
    printf "  %-44s %s\n" "./localnh stats" "Display library statistics"
    printf "  %-44s %s\n" "./localnh delete <id>" "Delete gallery entry and cached images"
    printf "  %-44s %s\n" "./localnh delete purge" "Delete all galleries and cache"
    printf "  %-44s %s\n" "./localnh pdf <id> <out_path>" "Export gallery to PDF"
    printf "  %-44s %s\n" "./localnh html <id> <out_path>" "Export gallery to HTML"
    printf "  %-44s %s\n" "./localnh snapshot export --offline" "Export DB/cache with writers stopped"
    printf "  %-44s %s\n" "./localnh snapshot import <path> --offline" "Import with writers stopped"
    exit 1
elif [ "$1" = "fetch" ]; then
    shift
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/fetch.py" "$@"
else
    exec "$PYTHON_EXEC" "$SCRIPT_DIR/script/py/fetch.py" "$@"
fi
